# Production build example — copy to .env.production then:
#   npm run build
#
# VITE_STUDIO_CHAT_WS_URL must match CMS liveChatWsUrl (wss:// host).

VITE_COMPOSITOR_API_URL=https://studio-compositor.tvstartupengine.com/api/compositor
VITE_PERSISTENCE_API_URL=https://persistence.tvstartupengine.com/api/persistence
VITE_TENANT_ID=
VITE_TENANT_NAME=
VITE_PERSISTENCE_ENABLED=true

# Studio session chat WebSocket — same service as CMS liveChatServer / liveChatWsUrl
VITE_STUDIO_CHAT_WS_URL=https://studio-api.tvstartupengine.com

VITE_STREAM_DESTINATION_MODAL=true
